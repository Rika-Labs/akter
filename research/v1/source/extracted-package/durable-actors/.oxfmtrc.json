{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "apps/docs/public/**",
    "research/retrieval-summary.json",
    "research/source-registry.json",
    "models/results/**",
    ".validation/**",
    "bun.lock",
    "context/**"
  ]
}
