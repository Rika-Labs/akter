{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "toolchain.lock.json",
    "tsconfig.base.json",
    ".oxlintrc.json",
    ".oxfmtrc.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
