{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "matchPackageNames": [
        "effect",
        "@effect/**"
      ],
      "groupName": "effect ecosystem",
      "automerge": false
    },
    {
      "matchPackageNames": [
        "typescript",
        "@effect/tsgo",
        "oxlint",
        "oxlint-tsgolint"
      ],
      "groupName": "verified native compiler and diagnostics tuple",
      "automerge": false
    },
    {
      "matchPackageNames": [
        "bun"
      ],
      "automerge": false
    }
  ]
}
