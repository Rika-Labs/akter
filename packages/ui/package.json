{
  "name": "@akter/ui",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./charts": {
      "types": "./src/charts/index.ts",
      "default": "./src/charts/index.ts"
    },
    "./geometry": {
      "types": "./src/geometry/index.ts",
      "default": "./src/geometry/index.ts"
    },
    "./tokens.stylex": {
      "types": "./src/tokens.stylex.ts",
      "default": "./src/tokens.stylex.ts"
    },
    "./markers.stylex": {
      "types": "./src/markers.stylex.ts",
      "default": "./src/markers.stylex.ts"
    },
    "./brand": {
      "types": "./src/brand/index.ts",
      "default": "./src/brand/index.ts"
    },
    "./base.css": "./src/base.css",
    "./fonts/PolySans-variable.woff2": "./assets/fonts/PolySans-variable.woff2",
    "./fonts/SagittaireDisplay-Regular.woff2": "./assets/fonts/SagittaireDisplay-Regular.woff2",
    "./fonts/GeistMono-latin.woff2": "./assets/fonts/GeistMono-latin.woff2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings --threads 1 .",
    "test": "bun --bun ../../node_modules/vitest/vitest.mjs run --root ../.. packages/ui/src"
  },
  "dependencies": {
    "@effect/platform-browser": "catalog:",
    "@stylexjs/stylex": "catalog:",
    "effect": "catalog:",
    "foldkit": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
