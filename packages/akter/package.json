{
  "name": "@rikalabs/akter",
  "version": "0.2.0",
  "description": "The framework for durable, stateful backends that power realtime apps, background work, and agents.",
  "keywords": [
    "actor-model",
    "actors",
    "agents",
    "background-jobs",
    "bun",
    "durable",
    "effect",
    "effect-ts",
    "realtime",
    "stateful",
    "transactions",
    "workflows"
  ],
  "homepage": "https://github.com/Rika-Labs/akter#readme",
  "bugs": "https://github.com/Rika-Labs/akter/issues",
  "license": "Apache-2.0",
  "author": "Rika Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rika-Labs/akter.git",
    "directory": "packages/akter"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "echo 'Publish through the release workflow: push a v<version> tag.' && exit 1",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings --threads 1 .",
    "test": "bun --bun ../../node_modules/vitest/vitest.mjs run --root ../.. packages/akter/src --exclude packages/akter/src/store/s3.test.ts",
    "test:integration": "bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts && node ../../node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@effect/platform-node-shared": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "@effect/platform-bun": {
      "optional": true
    },
    "@effect/platform-node": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24.0.0"
  }
}
