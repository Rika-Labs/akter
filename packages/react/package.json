{
  "name": "@akter/react",
  "private": true,
  "description": "React hooks for Akter over the Promise client: commands with one id per intent, queries, query watches, event feeds, connections, and optimistic state.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo -p tsconfig.json",
