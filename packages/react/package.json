    "test": "bun --bun ../../node_modules/vitest/vitest.mjs run --root ../.. packages/react/src"
  },
  "dependencies": {
    "@rikalabs/akter": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-orm": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  }
}
