{
  "name": "@durable-actors/create",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Scaffold a Durable Actors app: `bun create @durable-actors my-app`.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rika-Labs/durable-actors.git",
    "directory": "packages/create"
  },
  "bin": {
    "create-durable-actors": "./src/main.ts"
  },
  "files": [
    "src/*.ts",
    "!src/*.test.ts",
    "templates"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo -p tsconfig.json",
    "lint": "oxlint --type-aware --threads 1 src",
    "test": "bun --bun ../../node_modules/vitest/vitest.mjs run --root ../.. packages/create/src",
    "test:integration": "bun ../../.github/src/release/quickstart.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@durable-actors/core": "workspace:*",
    "@types/bun": "1.4.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
