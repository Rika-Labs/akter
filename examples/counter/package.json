{
  "name": "@durable-actors/counter",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings --threads 1 .",
    "test": "TEST_BACKEND=pglite bun --bun ../../node_modules/vitest/vitest.mjs run --root ../.. examples/counter/src",
    "test:integration": "TEST_BACKEND=postgres bun --bun ../../node_modules/vitest/vitest.mjs run --root ../.. examples/counter/src",
    "web": "bun src/web/serve.ts"
  },
  "dependencies": {
    "@durable-actors/core": "workspace:*",
    "@durable-actors/react": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "pg": "8.23.0",
    "vitest": "catalog:"
  }
}
