#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
case "${1:-}" in
  console)
    export APP_ORIGIN="${PUBLIC_URL%/}"
    exec bun --env-file=.env apps/console/dist/main.js
    ;;
  api)
    export APP_ORIGIN="${APP_ORIGIN%/}"
    exec bun --env-file=.env apps/api/src/main.ts
    ;;
  *) echo 'Expected console or api' >&2; exit 2 ;;
esac
