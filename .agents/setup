#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ "$(bun --version 2>/dev/null || true)" != "1.4.2" ]]; then
  npm install --global --force bun@1.4.2
fi
if [[ ! -x /usr/lib/postgresql/15/bin/initdb ]]; then
  sudo apt-get update -qq
  sudo apt-get install -y postgresql-15
fi
bun install --frozen-lockfile
if [[ ! -e .env ]]; then
  secret=$(openssl rand -hex 32)
  (umask 077; set -o noclobber; sed "s/^BETTER_AUTH_SECRET=.*/BETTER_AUTH_SECRET=$secret/" .env.example > .env)
  unset secret
fi
git config --local core.hooksPath .githooks
bun run build --filter @project/console

# Disposable orb-local data, never a remote DATABASE_URL. No server survives setup.
if [[ ! -f .local/postgres/PG_VERSION ]]; then
  mkdir -p .local/postgres .local/postgres-socket
  /usr/lib/postgresql/15/bin/initdb -D .local/postgres -U project --auth=trust >/dev/null
  /usr/lib/postgresql/15/bin/pg_ctl -D .local/postgres -l .local/postgres-setup.log \
    -o "-h 127.0.0.1 -p 5439 -k $PWD/.local/postgres-socket" -w start
  trap '/usr/lib/postgresql/15/bin/pg_ctl -D .local/postgres -m fast -w stop' EXIT
  /usr/lib/postgresql/15/bin/createdb -h 127.0.0.1 -p 5439 -U project project
  /usr/lib/postgresql/15/bin/pg_ctl -D .local/postgres -m fast -w stop
  trap - EXIT
fi
echo 'Ready. Run amp orb services ensure to start PostgreSQL, server and console.'
