# Local-only defaults; never copy production credentials into development.
NODE_ENV=development
PORT=3001
WEB_PORT=3000
API_ORIGIN=http://127.0.0.1:3001
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://project:project@localhost:5432/project
# setup generates a local signing secret without overwriting an existing value.
BETTER_AUTH_SECRET=
EMAIL_MODE=capture
RESEND_API_KEY=
EMAIL_FROM=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
AXIOM_TOKEN=
AXIOM_DATASET=
TYPESAFE_API_KEY=
INFISICAL_PROJECT_ID=
