{
  "$schema": "https://turbo.build/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "globalDependencies": ["tsconfig.json"],
  "globalPassThroughEnv": ["GOMAXPROCS"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**", "!**/*.test.ts"],
      "env": ["NODE_ENV"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**"],
      "outputs": [".cache/typecheck.tsbuildinfo"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!docs/**",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/tooling/oxlint/anti-slop/**",
        "$TURBO_ROOT$/tooling/oxlint/src/**"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**", "$TURBO_ROOT$/vitest.config.ts"],
      "outputs": [],
      "env": ["CI"]
    },
    "test:integration": {
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**", "$TURBO_ROOT$/vitest.config.ts"],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL", "TEST_REPLICA_DATABASE_URL", "CI"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["CI"]
    },
    "//#lint:root": {
      "inputs": [
        "*.ts",
        ".github/src/verify*.ts",
        ".github/src/evidence-gate.ts",
        ".github/src/github.ts",
        ".github/src/policy.ts",
        ".github/src/replica.ts",
        ".github/src/node-postgres.ts",
        ".github/src/release/smoke.ts",
        ".oxlintrc.json",
        "tooling/oxlint/anti-slop/**",
        "tooling/oxlint/src/**"
      ],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "deploy": {
      "cache": false
    },
    "destroy": {
      "cache": false
    },
    "migrate": {
      "cache": false
    }
  }
}
