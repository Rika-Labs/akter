{
  "$schema": "https://turbo.build/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "globalDependencies": ["tsconfig.json"],
  "globalPassThroughEnv": ["GOMAXPROCS"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**", "!**/*.test.ts"],
      "env": ["NODE_ENV"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**"],
      "outputs": [".cache/typecheck.tsbuildinfo"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!docs/**",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/tooling/oxlint/anti-slop/**",
        "$TURBO_ROOT$/tooling/oxlint/src/**"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**", "$TURBO_ROOT$/vitest.config.ts"],
      "outputs": [],
      "env": ["CI"]
    },
    "@durable-actors/ui#test": {
      "dependsOn": ["build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**", "$TURBO_ROOT$/vitest.config.ts"],
      "outputs": [],
      "env": ["CI"]
    },
    "@durable-actors/docs#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "$TURBO_ROOT$/docs/**"]
    },
    "@durable-actors/docs#test": {
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/**", "$TURBO_ROOT$/vitest.config.ts"],
      "outputs": [],
      "env": ["CI"]
    },
    "@durable-actors/doc-checks#test": {
      "dependsOn": ["^build", "transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/apps/*/README.md",
        "$TURBO_ROOT$/packages/*/README.md",
        "$TURBO_ROOT$/examples/*/README.md",
        "$TURBO_ROOT$/tooling/*/README.md",
        "$TURBO_ROOT$/infra/README.md",
        "$TURBO_ROOT$/vitest.config.ts"
      ],
      "outputs": [],
      "env": ["CI"]
    },
    "@durable-actors/infra#transit": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "$TURBO_ROOT$/.github/src/**"]
    },
    "@durable-actors/infra#lint": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/.github/**/*.ts",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/tooling/oxlint/anti-slop/**"
      ]
    },
    "test:integration": {
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**", "$TURBO_ROOT$/vitest.config.ts"],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL", "TEST_REPLICA_DATABASE_URL", "CI"]
    },
    "@durable-actors/create#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "templates/manifest.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/durable-actors/package.json",
        "$TURBO_ROOT$/.github/src/release/manifest.ts",
        "$TURBO_ROOT$/.github/src/release/template.ts"
      ]
    },
    "@durable-actors/create#test": {
      "dependsOn": ["build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "$TURBO_ROOT$/vitest.config.ts"],
      "outputs": [],
      "env": ["CI"]
    },
    "@durable-actors/create#test:integration": {
      "dependsOn": ["^build", "transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/.github/src/pack.ts",
        "$TURBO_ROOT$/.github/src/release/**",
        "$TURBO_ROOT$/packages/durable-actors/src/**",
        "$TURBO_ROOT$/packages/durable-actors/package.json"
      ],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL", "CI"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["CI"]
    },
    "//#lint:root": {
      "inputs": ["*.ts", ".oxlintrc.json", "tooling/oxlint/anti-slop/**", "tooling/oxlint/src/**"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "deploy": {
      "cache": false
    },
    "destroy": {
      "cache": false
    },
    "migrate": {
      "cache": false
    }
  }
}
