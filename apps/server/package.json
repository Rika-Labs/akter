{
  "name": "@project/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target=bun --packages=external --outdir=dist",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings --threads 1 .",
    "test": "bun --bun ../../node_modules/vitest/vitest.mjs run --root ../.. apps/server/test --exclude '**/test/integration/**'",
    "test:integration": "bun --bun ../../node_modules/vitest/vitest.mjs run --root ../.. apps/server/test/integration"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@project/auth": "workspace:*",
    "@project/billing": "workspace:*",
    "@project/contracts": "workspace:*",
    "@project/database": "workspace:*",
    "@project/email": "workspace:*",
    "@project/gateway": "workspace:*",
    "@project/observability": "workspace:*",
    "@project/runtime": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/pg": "8.23.1",
    "pg": "8.23.0",
    "vitest": "catalog:"
  }
}
