{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "incremental": true,
    "isolatedModules": true,
    "paths": {
      "collections/*": ["./.source/*"]
    },
    "types": ["node"]
  },
  "include": [
    "next-env.d.ts",
    "source.config.ts",
    "next.config.ts",
    "src",
    "scripts",
    ".source/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "out", ".next"]
}
