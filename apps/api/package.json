{
  "name": "@durable-actors/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target=bun --packages=external --outdir=dist",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings --threads 1 .",
    "test": "bun --bun ../../node_modules/vitest/vitest.mjs run --root ../.. apps/api/test --exclude '**/test/integration/**'",
    "test:integration": "bun --bun ../../node_modules/vitest/vitest.mjs run --root ../.. apps/api/test/integration"
  },
  "dependencies": {
    "@durable-actors/accounts": "workspace:*",
    "@durable-actors/billing": "workspace:*",
    "@durable-actors/contracts": "workspace:*",
    "@durable-actors/email": "workspace:*",
    "@durable-actors/observability": "workspace:*",
    "@durable-actors/postgres": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "@effect/sql-pg": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/pg": "8.23.1",
    "pg": "8.23.0",
    "vitest": "catalog:"
  }
}
