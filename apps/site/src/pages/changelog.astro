---
import * as stylex from "@stylexjs/stylex"
import Art from "../components/art.astro"
import Container from "../components/container.astro"
import { changelog } from "../changelog/changelog.styles.ts"
import { entries } from "../changelog/entries.ts"
import { longDate } from "../dates.ts"
import Base from "../layouts/base.astro"
import { page } from "../styles/page.styles.ts"
import { text } from "../styles/text.styles.ts"
---

<Base title="Changelog" description="New things in Akter, as they ship." path="/changelog" current="/changelog">
  <Container>
    <div {...stylex.attrs(page.intro, changelog.intro)}>
      <h1 {...stylex.attrs(text.hero, text.page)}>Changelog</h1>
      <p {...stylex.attrs(text.lede)}>New things in Akter, as they ship.</p>
    </div>
    {
      entries.map((entry) => (
        <article {...stylex.attrs(changelog.entry)}>
          <div {...stylex.attrs(changelog.when)}>
            <time datetime={entry.date} {...stylex.attrs(changelog.date)}>{longDate(entry.date)}</time>
            <div {...stylex.attrs(text.label, changelog.version)}>{entry.version}</div>
          </div>
          <div>
            <h2 {...stylex.attrs(text.section, changelog.title)}>{entry.title}</h2>
            <p {...stylex.attrs(text.body, changelog.summary)}>{entry.summary}</p>
            {
              entry.illustrated === true && (
                <div {...stylex.attrs(changelog.art)}>
                  <Art source="crane" viewBox="0 0 1080 300" />
                </div>
              )
            }
            {
              entry.improvements.length > 0 && (
                <>
                  <h3 {...stylex.attrs(changelog.group)}>Improvements</h3>
                  <ul {...stylex.attrs(changelog.list)}>
                    {entry.improvements.map((item) => <li {...stylex.attrs(changelog.item)}>{item}</li>)}
                  </ul>
                </>
              )
            }
            {
              entry.fixes.length > 0 && (
                <>
                  <h3 {...stylex.attrs(changelog.group)}>Fixes</h3>
                  <ul {...stylex.attrs(changelog.list)}>
                    {entry.fixes.map((item) => <li {...stylex.attrs(changelog.item)}>{item}</li>)}
                  </ul>
                </>
              )
            }
          </div>
        </article>
      ))
    }
  </Container>
</Base>
