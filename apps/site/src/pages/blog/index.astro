---
import * as stylex from "@stylexjs/stylex"
import Art from "../../components/art.astro"
import Container from "../../components/container.astro"
import { blog } from "../../blog/blog.styles.ts"
import { posts } from "../../blog/posts.ts"
import { shortDate } from "../../dates.ts"
import Base from "../../layouts/base.astro"
import { page } from "../../styles/page.styles.ts"
import { text } from "../../styles/text.styles.ts"

const [featured] = posts
---

<Base title="Blog" description="Notes from building Akter." path="/blog" current="/blog">
  <Container>
    <div {...stylex.attrs(page.intro)}>
      <h1 {...stylex.attrs(text.hero, text.page)}>Blog</h1>
      <p {...stylex.attrs(text.lede)}>Notes from building Akter.</p>
    </div>
    {
      featured !== undefined && (
        <a href={`/blog/${featured.slug}`} {...stylex.attrs(blog.feature)}>
          <div {...stylex.attrs(blog.art)}>
            <div {...stylex.attrs(blog.artInner)}>
              <Art source="crane" viewBox="0 0 1080 300" />
            </div>
          </div>
          <div {...stylex.attrs(blog.text)}>
            <div>
              <div {...stylex.attrs(text.label)}>{featured.category} · {shortDate(featured.published)}</div>
              <h2 {...stylex.attrs(text.section, blog.title)}>{featured.title}</h2>
              <p {...stylex.attrs(text.body, blog.summary)}>{featured.summary}</p>
            </div>
            <span {...stylex.attrs(text.link)}>Read the post<span {...stylex.attrs(blog.arrow)}>→</span></span>
          </div>
        </a>
      )
    }
  </Container>
</Base>
