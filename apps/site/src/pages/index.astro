---
import * as stylex from "@stylexjs/stylex"
import Art from "../components/art.astro"
import Banner from "../components/banner.astro"
import Button from "../components/button.astro"
import Chip from "../components/chip.astro"
import Container from "../components/container.astro"
import ExternalIcon from "../components/external-icon.astro"
import Faq from "../components/faq.astro"
import FigureOne from "../components/figure-one.astro"
import Section from "../components/section.astro"
import { crashTest, hotKey, latency } from "../benchmarks/report.ts"
import { builds, places, questions } from "../landing/copy.ts"
import { builds as buildStyles, hero, prose, proof, where } from "../landing/sections.styles.ts"
import Base from "../layouts/base.astro"
import { announcementUrl, benchmarkReportUrl, docsUrl, headline, quickstartUrl } from "../site.ts"
import { text } from "../styles/text.styles.ts"

const thumbnails = [
  { x: 7, y: 46 },
  { x: 97, y: 50 },
  { x: 205, y: 46 },
]
const fastest = hotKey[0]?.operationsPerSecond ?? 1
const step = 10 ** Math.floor(Math.log10(fastest)) / 5
const axisMax = Math.ceil(fastest / step) * step
const count = (value: number) => value.toLocaleString("en-US")
---

<Base title="Akter" path="/">
  <Container>
    <div {...stylex.attrs(hero.root)}>
      <Chip href={announcementUrl} message="Akter 0.1 alpha is out" action="Read the post" />
      <h1 {...stylex.attrs(text.hero, hero.title)}>{headline}</h1>
      <div {...stylex.attrs(hero.actions)}>
        <Button href={quickstartUrl} tile>Start building</Button>
        <Button href={docsUrl} variant="ghost" external arrow>Read the docs</Button>
      </div>
      <div {...stylex.attrs(hero.art)}>
        <Art
          source="crane"
          viewBox="0 0 1080 300"
          label="A container port: a gantry crane lifting a container between two stacks, over water"
          phoneCrop
        />
      </div>
    </div>

    <Section heading="Why Akter">
      <p {...stylex.attrs(prose.paragraph)}>
        Most backends keep each thing in pieces. An order's state sits in one table, its retries in a queue, its timers in cron, and its live updates on a socket server. When a process dies halfway through, the pieces drift apart.
      </p>
      <p {...stylex.attrs(prose.paragraph)}>
        <span {...stylex.attrs(prose.lead)}>Every part of your app should have one home.</span>
      </p>
      <p {...stylex.attrs(prose.paragraph)}>
        Akter gives each order, chat room or agent session its own <b {...stylex.attrs(prose.strong)}>actor</b>: an address, its own state and tables, its jobs and events, and its live clients. It handles one request at a time and commits each one in a single database transaction, so nothing is half-written and nothing runs twice.
      </p>
      <div {...stylex.attrs(prose.figure)}>
        <FigureOne caption="Figure 1. Requests reach one actor by its address. It commits each one to your Postgres database in a single transaction, then pushes the change to every connected client." />
      </div>
    </Section>

    <Section heading="What you build">
      {
        builds.map((item, index) => (
          <div {...stylex.attrs(buildStyles.row)}>
            <div {...stylex.attrs(buildStyles.thumb)}>
              <Art source="strip" viewBox={`${thumbnails[index]?.x} ${thumbnails[index]?.y} 91 91`} />
            </div>
            <div>
              <h3 {...stylex.attrs(text.title)}>{item.title}</h3>
              <p {...stylex.attrs(text.body, buildStyles.text)}>{item.text}</p>
            </div>
          </div>
        ))
      }
    </Section>

    <section {...stylex.attrs(proof.root)}>
      <p {...stylex.attrs(proof.promise)}>
        We kill processes and cut the network on purpose, <b {...stylex.attrs(proof.emphasis)}>then check every acknowledgement.</b>
      </p>
      <div {...stylex.attrs(proof.grid)}>
        <div {...stylex.attrs(proof.stack)}>
          <div {...stylex.attrs(proof.card)}>
            <h3 {...stylex.attrs(text.title, proof.title)}>Crash test</h3>
            <div {...stylex.attrs(text.label, proof.label)}>Process kills and network partitions</div>
            <div {...stylex.attrs(proof.figure)}>
              {count(crashTest.acknowledged)}<small {...stylex.attrs(proof.unit)}>acknowledged</small>
            </div>
            <div {...stylex.attrs(proof.trio)}>
              <div>{count(crashTest.missing)}<span {...stylex.attrs(text.label, proof.trioLabel)}>Lost</span></div>
              <div>{count(crashTest.repeated)}<span {...stylex.attrs(text.label, proof.trioLabel)}>Duplicated</span></div>
              <div>{count(crashTest.unknown)}<span {...stylex.attrs(text.label, proof.trioLabel)}>Unknown</span></div>
            </div>
          </div>
          <div {...stylex.attrs(proof.card)}>
            <h3 {...stylex.attrs(text.title, proof.title)}>Latency</h3>
            <div {...stylex.attrs(text.label, proof.label)}>p50 on one host, not an SLO</div>
            <div {...stylex.attrs(proof.latency)}>
              <span {...stylex.attrs(proof.latencyLabel)}>Write</span>
              <span {...stylex.attrs(proof.latencyValue)}>{latency.write.toFixed(2)}<small {...stylex.attrs(proof.unit)}>ms</small></span>
              <span {...stylex.attrs(proof.latencyLabel)}>Fresh read</span>
              <span {...stylex.attrs(proof.latencyValue)}>{latency.freshRead.toFixed(2)}<small {...stylex.attrs(proof.unit)}>ms</small></span>
            </div>
          </div>
        </div>
        <div {...stylex.attrs(proof.card)}>
          <h3 {...stylex.attrs(text.title, proof.title)}>One hot key, 64 callers</h3>
          <div {...stylex.attrs(text.label, proof.label)}>Writes per second, median of 3 runs</div>
          <div {...stylex.attrs(proof.figure)}>
            {count(Math.round(fastest))}<small {...stylex.attrs(proof.unit)}>op/s</small>
          </div>
          <div {...stylex.attrs(proof.bars)} role="img" aria-label={`Writes per second: ${hotKey.map((row) => `${row.system} ${count(Math.round(row.operationsPerSecond))}`).join(", ")}`}>
            {
              hotKey.map((row) => (
                <div
                  style={`height:${Math.max(1.5, (row.operationsPerSecond / axisMax) * 100)}%`}
                  {...stylex.attrs(proof.bar, row.system === "Akter" && proof.barAkter)}
                ></div>
              ))
            }
          </div>
          <div {...stylex.attrs(proof.barLabels)} aria-hidden="true">
            {hotKey.map((row) => <span {...stylex.attrs(proof.barLabel, row.system === "Akter" && proof.barLabelAkter)}>{row.system}</span>)}
          </div>
          <p {...stylex.attrs(proof.report)}>
            <a href={benchmarkReportUrl} target="_blank" rel="noopener noreferrer" {...stylex.attrs(text.link, proof.reportLink)}>
              Read the benchmark report
              <ExternalIcon xstyle={proof.arrow} />
            </a>
          </p>
        </div>
      </div>
    </section>

    <Section heading="Akter runs where your data lives.">
      <p {...stylex.attrs(text.body)}>Start inside the process you already run. Serve it when you need to, or let us host it.</p>
      <div slot="below" {...stylex.attrs(where.grid)}>
        {
          places.map((place) => (
            <div {...stylex.attrs(where.card)}>
              <div {...stylex.attrs(where.top)}>
                <h3 {...stylex.attrs(text.title)}>{place.title}</h3>
                <span {...stylex.attrs(where.number)}>{place.number}</span>
              </div>
              <p {...stylex.attrs(where.text)}>{place.text}</p>
              <div {...stylex.attrs(where.pic)}>
                <Art source="crane" viewBox={place.viewBox} xstyle={where.art} />
              </div>
            </div>
          ))
        }
      </div>
    </Section>

    <Section heading="Questions">
      <Faq entries={questions} />
    </Section>

    <Banner />
  </Container>
</Base>
