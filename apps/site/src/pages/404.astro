---
import * as stylex from "@stylexjs/stylex"
import Art from "../components/art.astro"
import Button from "../components/button.astro"
import Container from "../components/container.astro"
import Base from "../layouts/base.astro"
import { docsUrl } from "../site.ts"
import { notFound } from "../styles/not-found.styles.ts"
import { text } from "../styles/text.styles.ts"
---

<Base title="Not found" description="This page isn't here." path="/404" noindex>
  <Container>
    <div {...stylex.attrs(notFound.root)}>
      <div {...stylex.attrs(text.label)}>Error 404</div>
      <h1 {...stylex.attrs(text.hero, text.page, notFound.title)}>This page isn't here.</h1>
      <p {...stylex.attrs(text.lede, notFound.lede)}>It may have moved, or it never shipped.</p>
      <div {...stylex.attrs(notFound.actions)}>
        <Button href="/">Go home</Button>
        <Button href={docsUrl} variant="ghost" external arrow>Search the docs</Button>
      </div>
      <div {...stylex.attrs(notFound.art)}>
        <Art source="crane" viewBox="0 0 1080 300" phoneCrop />
      </div>
    </div>
  </Container>
</Base>
