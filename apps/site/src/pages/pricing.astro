---
import * as stylex from "@stylexjs/stylex"
import Banner from "../components/banner.astro"
import Button from "../components/button.astro"
import Container from "../components/container.astro"
import Faq from "../components/faq.astro"
import Section from "../components/section.astro"
import Base from "../layouts/base.astro"
import { estimate, tiers as tierStyles, usage } from "../pricing/pricing.styles.ts"
import { estimateControls, meters, pricingQuestions, tiers } from "../pricing/tiers.ts"
import { page } from "../styles/page.styles.ts"
import { text } from "../styles/text.styles.ts"
---

<Base
  title="Pricing"
  description="Free to self-host, forever. On Akter Cloud you pay for the commands you commit."
  path="/pricing"
  current="/pricing"
>
  <Container>
    <div {...stylex.attrs(page.intro)}>
      <h1 {...stylex.attrs(text.hero, text.page)}>Pricing</h1>
      <p {...stylex.attrs(text.lede)}>Free to self-host, forever. On Akter Cloud you pay for the commands you commit.</p>
    </div>

    <div {...stylex.attrs(tierStyles.grid)}>
      {
        tiers.map((tier) => (
          <div {...stylex.attrs(tierStyles.card, tier.featured === true && tierStyles.featured)}>
            <h2 {...stylex.attrs(text.title)}>{tier.name}</h2>
            <div {...stylex.attrs(tierStyles.price)}>
              {tier.price}<small {...stylex.attrs(tierStyles.period)}>{tier.period}</small>
            </div>
            <p {...stylex.attrs(tierStyles.summary)}>{tier.summary}</p>
            <div {...stylex.attrs(tierStyles.action)}>
              <Button href={tier.href} variant={tier.featured === true ? "primary" : "ghost"} block>{tier.cta}</Button>
            </div>
            <ul {...stylex.attrs(tierStyles.features)}>
              {tier.features.map((feature) => <li {...stylex.attrs(tierStyles.feature)}>{feature}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
    <p {...stylex.attrs(text.note)}>Prices are placeholders until Akter Cloud launches.</p>

    <Section heading="How usage is billed">
      <div {...stylex.attrs(usage.wrap)}>
        <table {...stylex.attrs(usage.table)}>
          <thead>
            <tr>
              <th scope="col" {...stylex.attrs(usage.cell, usage.head)}>Meter</th>
              <th scope="col" {...stylex.attrs(usage.cell, usage.head)}>Free</th>
              <th scope="col" {...stylex.attrs(usage.cell, usage.head, usage.last)}>Pro and Team</th>
            </tr>
          </thead>
          <tbody>
            {
              meters.map((meter) => (
                <tr>
                  <th scope="row" {...stylex.attrs(usage.cell)}>{meter.meter}</th>
                  <td {...stylex.attrs(usage.cell)}>{meter.free}</td>
                  <td {...stylex.attrs(usage.cell, usage.last)}>{meter.paid}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p {...stylex.attrs(text.note)}>Spend caps stop new requests at the edge. Work already admitted is allowed to finish.</p>
    </Section>

    <Section heading="Estimate your bill">
      <div {...stylex.attrs(estimate.card)} role="group" aria-label="Bill estimate, available once prices are set">
        {
          estimateControls.map((control) => (
            <div {...stylex.attrs(estimate.control)}>
              <span>{control.label}</span>
              <div {...stylex.attrs(estimate.options)}>
                {control.options.map((option) => <span {...stylex.attrs(estimate.option, option === control.on && estimate.on)}>{option}</span>)}
              </div>
            </div>
          ))
        }
        <div {...stylex.attrs(estimate.total)}>$—<small {...stylex.attrs(estimate.unit)}>/ month</small></div>
        <p {...stylex.attrs(text.note)}>The estimator fills in once prices are set.</p>
      </div>
    </Section>

    <Section heading="Questions">
      <Faq entries={pricingQuestions} />
    </Section>

    <Banner title="Start free, pay when it's running." body="Self-host for free, or deploy to Akter Cloud with 1M commands free each month." />
  </Container>
</Base>
