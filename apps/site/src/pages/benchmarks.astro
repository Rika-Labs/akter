---
import * as stylex from "@stylexjs/stylex"
import BenchmarkBars from "../components/benchmark-bars.astro"
import Button from "../components/button.astro"
import Container from "../components/container.astro"
import PageHeader from "../components/page-header.astro"
import Panel from "../components/panel.astro"
import Stat from "../components/stat.astro"
import { cases as charts, drills, finalControl, headlines, isFinalControl } from "../benchmarks/report.ts"
import { cases, crash, limits, setup, strip } from "../benchmarks/benchmarks.styles.ts"
import Base from "../layouts/base.astro"
import { benchmarkReportUrl } from "../site.ts"
import { text } from "../styles/text.styles.ts"

const loses = [
  "Plain Postgres and Redis were much faster. They skip actor lifecycle, receipts, events and the outbox.",
  "Restate roughly doubled Akter's throughput across 10,000 keys.",
  "DBOS's direct-SQL reads were faster than Akter's actor read path.",
  "Cloud and isolate advantages, like Cloudflare's replication network, are not measured here.",
]
const finePrint = [
  "Same-host observations on one sandbox, not production SLOs.",
  "Systems acknowledge at different durability boundaries; the report lists each one.",
  'Missing or timed-out cases stay "not collected", never a pass.',
]
const headlineStats = [
  { label: "Sequential write p50", value: `${headlines.sequentialWriteP50.toFixed(2)} ms`, caption: "one caller, one key" },
  { label: "Hot key", value: Math.round(headlines.hotKey).toLocaleString("en-US"), caption: "op/s, 64 callers on one key" },
  { label: "10,000 fresh keys", value: Math.round(headlines.freshKeys).toLocaleString("en-US"), caption: "op/s, 64 callers" },
  { label: "Fresh read p50", value: `${headlines.freshReadP50.toFixed(2)} ms`, caption: "committed state over HTTP" },
]
const largestDrill = Math.max(...drills.map((drill) => drill.acknowledged))
const count = (value: number): string => value.toLocaleString("en-US")
---

<Base
  title="Benchmarks"
  description="Akter against six actor and workflow systems and two plain databases, on the same machine, under the same HTTP workload. Medians of three runs, with the cases where Akter loses and the cases that were not collected."
  path="/benchmarks"
  current="/benchmarks"
>
  <Container>
    <PageHeader
      title="Measured, not promised."
      lead="Akter against six actor and workflow systems and two plain databases, on the same machine, under the same HTTP workload. Medians of three runs. Where Akter loses, it says so."
    />

    <div {...stylex.attrs(strip.root)}>
      {
        headlineStats.map((item, index) => (
          <div {...stylex.attrs(strip.cell, index === 2 && strip.oddStart, index > 1 && strip.second)}>
            <Stat label={item.label} value={item.value} caption={item.caption} />
          </div>
        ))
      }
    </div>

    <div {...stylex.attrs(setup.root)}>
      <p {...stylex.attrs(setup.item)}><strong {...stylex.attrs(setup.strong)}>Machine.</strong> One Daytona sandbox, 4 CPUs and 8 GiB shared by every app, database and driver.</p>
      <p {...stylex.attrs(setup.item)}><strong {...stylex.attrs(setup.strong)}>Systems.</strong> Rivet (two save modes), workerd local, Restate, Temporal, DBOS, plain Postgres, plain Redis.</p>
      <p {...stylex.attrs(setup.item)}><strong {...stylex.attrs(setup.strong)}>When.</strong> 2026-10-01 to 02. Three rounds, forward, reverse, forward.</p>
    </div>
    <p {...stylex.attrs(setup.key)}>Each bar is the median of three rounds; the hairline beneath it spans the lowest to the highest round. Plain Postgres and Redis are printed beside each case, not drawn, because they skip what an actor adds.</p>

    <div {...stylex.attrs(cases.root)}>
      {charts.map((data) => <Panel><BenchmarkBars data={data} /></Panel>)}
    </div>

    <Panel padding="none" clip>
      <div {...stylex.attrs(crash.root)} id="failure-drills">
        <div {...stylex.attrs(crash.summary)}>
          <span {...stylex.attrs(text.display, crash.big)}>{count(finalControl.acknowledged)}</span>
          <p {...stylex.attrs(crash.caption)}>acknowledged IDs in the final crash and partition control</p>
          <div {...stylex.attrs(crash.zeros)}>
            <Stat tone="mono" value={String(finalControl.missing)} caption="lost" />
            <Stat tone="mono" value={String(finalControl.repeated)} caption="duplicated" />
            <Stat tone="mono" value={String(finalControl.unknown)} caption="unknown" />
            <Stat tone="mono" value="0" caption="misrouted" />
          </div>
          <p {...stylex.attrs(crash.note)}>
            Each drill injects four failures: killing the app, killing storage, or partitioning the network. Every acknowledged ID is read back afterwards.
          </p>
        </div>
        <div {...stylex.attrs(crash.ledger)}>
          <table {...stylex.attrs(crash.table)}>
            <thead>
              <tr>
                <th {...stylex.attrs(crash.th)}>Round</th>
                <th {...stylex.attrs(crash.th)}>Drill</th>
                <th {...stylex.attrs(crash.th, crash.num)}>Acknowledged</th>
                <th {...stylex.attrs(crash.th, crash.num)}>Missing</th>
                <th {...stylex.attrs(crash.th, crash.num)}>Repeated</th>
                <th {...stylex.attrs(crash.th, crash.num)}>Unknown</th>
              </tr>
            </thead>
            <tbody>
              {
                drills.map((drill) => {
                  const final = isFinalControl(drill)
                  return (
                    <tr>
                      <td {...stylex.attrs(crash.td, final && crash.tdFinal)}>{drill.round}</td>
                      <td {...stylex.attrs(crash.td, final && crash.tdFinal)}>{drill.drill}</td>
                      <td {...stylex.attrs(crash.td, final && crash.tdFinal, crash.num)}>
                        <span {...stylex.attrs(crash.ack)}>
                          <svg {...stylex.attrs(crash.tick)} aria-hidden="true">
                            <rect x="0" y="0" height="100%" rx="3" width={`${(drill.acknowledged / largestDrill) * 100}%`} {...stylex.attrs(crash.tickBar, final && crash.tickFinal)} />
                          </svg>
                          {count(drill.acknowledged)}
                        </span>
                      </td>
                      <td {...stylex.attrs(crash.td, final && crash.tdFinal, crash.num)}>{drill.missing}</td>
                      <td {...stylex.attrs(crash.td, final && crash.tdFinal, crash.num)}>{drill.repeated}</td>
                      <td {...stylex.attrs(crash.td, final && crash.tdFinal, crash.num, drill.unknown > 0 && crash.flagged)}>{drill.unknown}</td>
                    </tr>
                  )
                })
              }
            </tbody>
          </table>
        </div>
      </div>
    </Panel>

    <div {...stylex.attrs(limits.root)}>
      <Panel>
        <h2 {...stylex.attrs(text.display, limits.title)}>Where we lose</h2>
        <ul {...stylex.attrs(limits.list)}>{loses.map((line) => <li>{line}</li>)}</ul>
      </Panel>
      <Panel>
        <h2 {...stylex.attrs(text.display, limits.title)}>The fine print</h2>
        <ul {...stylex.attrs(limits.list)}>{finePrint.map((line) => <li>{line}</li>)}</ul>
        <div {...stylex.attrs(limits.actions)}>
          <Button href={benchmarkReportUrl} external>Full report ↗</Button>
          <Button href={`${benchmarkReportUrl}#hardware-isolation-and-method`} external>Method</Button>
          <Button href={`${benchmarkReportUrl}#failure-drills`} external>Failure drills</Button>
        </div>
      </Panel>
    </div>
  </Container>
</Base>
