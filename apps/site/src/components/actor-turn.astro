---
import * as stylex from "@stylexjs/stylex"
import type { Layout, Node } from "../illustrations/actor-turn.ts"
import { tallLayout, wideLayout } from "../illustrations/actor-turn.ts"
import { turn } from "./actor-turn.styles.ts"

const layouts = [
  { layout: wideLayout, style: turn.wide, box: `0 28 ${wideLayout.width} ${wideLayout.height - 36}` },
  { layout: tallLayout, style: turn.tall, box: `-14 0 ${tallLayout.width + 14} ${tallLayout.height}` },
] satisfies ReadonlyArray<{ layout: Layout; style: stylex.StyleXStyles; box: string }>

const description =
  "A command passes the fence and the receipt check, runs the handler and commits state, rows, events, its receipt and the outbox in one transaction. The reply follows the commit, and the outbox then delivers messages, fires timers and runs jobs."

const detailY = (node: Node, line: number): number => node.y + 38 + line * 12.5
---

<div {...stylex.attrs(turn.wrap)}>
  {
    layouts.map(({ layout, style, box }) => (
      <svg viewBox={box} role="img" aria-label={description} {...stylex.attrs(style)}>
        <rect
          x={layout.region.x}
          y={layout.region.y}
          width={layout.region.width}
          height={layout.region.height}
          rx="12"
          {...stylex.attrs(turn.region)}
        />
        <text x={layout.region.labelX} y={layout.region.labelY} {...stylex.attrs(turn.caption)}>
          one turn, one transaction
        </text>
        {layout.links.map((link) => (
          <>
            <path d={link.line} {...stylex.attrs(turn.link, link.drawn && turn.linkDashed)} />
            <path d={link.head} {...stylex.attrs(turn.head)} />
            {link.drawn && (
              <>
                <path
                  d={link.line}
                  stroke-width="1.5"
                  style={`--length:${link.length};stroke-dasharray:${link.length};animation-delay:${link.delay}s`}
                  {...stylex.attrs(turn.trace)}
                />
                <path
                  d={link.head}
                  stroke-width="1.5"
                  style={`animation-delay:${link.delay + 0.4}s`}
                  {...stylex.attrs(turn.headLit)}
                />
              </>
            )}
          </>
        ))}
        <g
          transform={`translate(${layout.travel.x} ${layout.travel.y})`}
        >
          <g
            style={`--distance:${layout.travel.distance}px`}
            {...stylex.attrs(layout.travel.axis === "x" ? turn.packetX : turn.packetY)}
          >
            <rect x="-9" y="-6" width="18" height="12" rx="3" {...stylex.attrs(turn.packet)} />
            <path d="M-4 -1.5 H4 M-4 2 H1" stroke-width="1.1" {...stylex.attrs(turn.packetMark)} />
          </g>
        </g>
        {[...layout.nodes, ...layout.afterNodes].map((node) => (
          <g>
            <rect
              x={node.x}
              y={node.y}
              width={node.width}
              height={node.height}
              rx="8"
              stroke-width={node.title === "Commit" ? 1.25 : 1}
              {...stylex.attrs(turn.node, node.title === "Commit" && turn.pivot)}
            />
            <rect
              x={node.x}
              y={node.y}
              width={node.width}
              height={node.height}
              rx="8"
              stroke-width="1.25"
              style={`animation-delay:${node.delay}s`}
              {...stylex.attrs(turn.lit)}
            />
            <text
              x={node.x + 12}
              y={node.y + (node.lines[0] === "" ? node.height / 2 + 4.5 : 22)}
              {...stylex.attrs(turn.title)}
            >
              {node.title}
            </text>
            {node.lines.map((content, line) =>
              content === "" ? null : (
                <text x={node.x + 12} y={detailY(node, line)} {...stylex.attrs(turn.detail)}>
                  {content}
                </text>
              ),
            )}
          </g>
        ))}
        <text
          x={layout.afterLabel.x}
          y={layout.afterLabel.y}
          text-anchor={layout.afterLabel.anchor}
          {...stylex.attrs(turn.caption)}
        >
          after the commit
        </text>
      </svg>
    ))
  }
</div>
