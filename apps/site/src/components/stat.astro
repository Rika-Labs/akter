---
import * as stylex from "@stylexjs/stylex"
import { stat } from "./stat.styles.ts"

interface Props {
  label?: string
  value: string
  caption?: string
  tone?: "display" | "mono"
}

const { label, value, caption, tone = "display" } = Astro.props
---

<div {...stylex.attrs(stat.root)}>
  {label !== undefined && <span {...stylex.attrs(stat.label)}>{label}</span>}
  <b {...stylex.attrs(stat.value, tone === "mono" && stat.mono)}>{value}</b>
  {caption !== undefined && <span {...stylex.attrs(stat.caption)}>{caption}</span>}
</div>
