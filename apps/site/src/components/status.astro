---
import * as stylex from "@stylexjs/stylex"
import { status } from "../examples/examples.styles.ts"

interface Props {
  state: "live" | "planned"
}

const { state } = Astro.props
---

<span {...stylex.attrs(status.root, state === "live" && status.live)}>
  <span {...stylex.attrs(status.dot, state === "planned" && status.planned)} aria-hidden="true"></span>
  <slot />
</span>
