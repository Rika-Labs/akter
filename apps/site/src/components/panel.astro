---
import * as stylex from "@stylexjs/stylex"
import { panel } from "./panel.styles.ts"

interface Props {
  as?: "div" | "section" | "article" | "a" | "li"
  padding?: "none" | "snug" | "padded"
  tone?: "card" | "inverse" | "muted"
  clip?: boolean
  interactive?: boolean
  href?: string
  "data-topic"?: string
}

const {
  as: Tag = "div",
  padding = "padded",
  tone = "card",
  clip = false,
  interactive = false,
  href,
  ...rest
} = Astro.props
---

<Tag
  href={href}
  {...rest}
  {...stylex.attrs(
    panel.root,
    padding === "padded" && panel.padded,
    padding === "snug" && panel.snug,
    clip && panel.clip,
    tone === "inverse" && panel.inverse,
    tone === "muted" && panel.muted,
    interactive && panel.interactive,
  )}
>
  <slot />
</Tag>
