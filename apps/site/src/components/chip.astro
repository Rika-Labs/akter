---
import * as stylex from "@stylexjs/stylex"
import { chip } from "./chip.styles.ts"
import ExternalIcon from "./external-icon.astro"

interface Props {
  href: string
  message: string
  action: string
}

const { href, message, action } = Astro.props
---

<a href={href} {...stylex.attrs(chip.root)}>
  <span {...stylex.attrs(chip.part)}>
    <i {...stylex.attrs(chip.dot)}></i>
    {message}
  </span>
  <span {...stylex.attrs(chip.part, chip.action)}>
    {action}
    <ExternalIcon />
  </span>
</a>
