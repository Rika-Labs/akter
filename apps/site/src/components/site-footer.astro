---
import * as stylex from "@stylexjs/stylex"
import { benchmarkReportUrl, githubUrl, pages, quickstartUrl } from "../site.ts"
import Art from "./art.astro"
import Container from "./container.astro"
import { footer } from "./site-footer.styles.ts"
import Wordmark from "./wordmark.astro"

const columns = [
  { heading: "Product", links: pages },
  {
    heading: "Developers",
    links: [
      { label: "Quickstart", href: quickstartUrl },
      { label: "GitHub", href: githubUrl },
      { label: "Benchmark report", href: benchmarkReportUrl },
    ],
  },
  {
    heading: "Community",
    links: [
      { label: "Issues", href: `${githubUrl}/issues` },
      { label: "Contributing", href: `${githubUrl}/blob/main/CONTRIBUTING.md` },
    ],
  },
  {
    heading: "Legal",
    links: [
      { label: "Apache-2.0", href: `${githubUrl}/blob/main/LICENSE` },
      { label: "Security", href: `${githubUrl}/blob/main/SECURITY.md` },
    ],
  },
]
---

<footer {...stylex.attrs(footer.root)}>
  <Container>
    <div {...stylex.attrs(footer.columns)}>
      {
        columns.map((column) => (
          <div>
            <h2 {...stylex.attrs(footer.heading)}>{column.heading}</h2>
            <ul>
              {column.links.map((link) => (
                <li {...stylex.attrs(footer.item)}>
                  <a href={link.href} {...stylex.attrs(footer.link)}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <a href="/" aria-label="Akter home" {...stylex.attrs(footer.brand)}>
        <Wordmark />
      </a>
    </div>
    <div {...stylex.attrs(footer.strip)}>
      <Art source="strip" viewBox="0 0 1080 140" />
    </div>
  </Container>
</footer>
