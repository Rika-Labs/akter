---
import * as stylex from "@stylexjs/stylex"
import Drawing from "../illustrations/drawing.astro"
import { containerStrip } from "../illustrations/scenes.ts"
import { githubUrl, pages } from "../site.ts"
import Container from "./container.astro"
import { footer } from "./site-footer.styles.ts"
import Wordmark from "./wordmark.astro"

interface Props {
  variant?: "full" | "compact"
  width?: "site" | "landing"
}

const { variant = "compact", width = "site" } = Astro.props
const columns = [
  { heading: "Project", links: pages.map((page) => ({ label: page.label, href: page.href })) },
  {
    heading: "Community",
    links: [
      { label: "GitHub", href: githubUrl },
      { label: "Issues", href: `${githubUrl}/issues` },
    ],
  },
  {
    heading: "Legal",
    links: [
      { label: "Apache-2.0", href: `${githubUrl}/blob/main/LICENSE` },
      { label: "Security", href: `${githubUrl}/blob/main/SECURITY.md` },
    ],
  },
]
const compactLinks = [
  ...pages,
  { label: "GitHub", href: githubUrl },
  { label: "Apache-2.0", href: `${githubUrl}/blob/main/LICENSE` },
]
---

<Container as="footer" width={width}>
  <div {...stylex.attrs(footer.root)}>
    {
      variant === "full" ? (
        <>
          <div {...stylex.attrs(footer.full)}>
            {columns.map((column) => (
              <div {...stylex.attrs(footer.column)}>
                <h2 {...stylex.attrs(footer.heading)}>{column.heading}</h2>
                {column.links.map((link) => (
                  <a href={link.href} {...stylex.attrs(footer.link)}>
                    {link.label}
                  </a>
                ))}
              </div>
            ))}
            <a href="/" aria-label="Akter home" {...stylex.attrs(footer.brand)}>
              <Wordmark size="footer" />
            </a>
          </div>
          <div {...stylex.attrs(footer.strip)} aria-hidden="true">
            <svg viewBox="0 0 1080 140" {...stylex.attrs(footer.stripSvg)}>
              <Drawing items={containerStrip} />
            </svg>
          </div>
        </>
      ) : (
        <div {...stylex.attrs(footer.compact)}>
          <a href="/" aria-label="Akter home" {...stylex.attrs(footer.brand)}>
            <Wordmark />
          </a>
          <nav aria-label="Footer" {...stylex.attrs(footer.inline)}>
            {compactLinks.map((link) => (
              <a href={link.href} {...stylex.attrs(footer.link)}>
                {link.label}
              </a>
            ))}
          </nav>
        </div>
      )
    }
  </div>
</Container>
