---
import { mark } from "@akter/ui/brand"
import * as stylex from "@stylexjs/stylex"
import FigureTile from "./figure-tile.astro"
import { figureOne } from "./figure-one.styles.ts"

interface Props {
  caption: string
}

const { caption } = Astro.props
const routes = ["M94 104 H130 V232 M94 204 H130 M94 296 H130 V204", "M130 190 H186", "M454 198 H520"]
---

<figure>
  <div {...stylex.attrs(figureOne.box)}>
    <svg
      viewBox="0 0 640 360"
      role="img"
      aria-label="Requests from a browser, your API and a schedule reach one actor, which commits to a database in one transaction and pushes the change to live clients"
      {...stylex.attrs(figureOne.svg)}
    >
      <text x="38" y="58" font-size="10.5" letter-spacing="1" fill="currentColor" fill-opacity=".7">REQUESTS</text>
      <FigureTile x={38} y={76} icon="browser" label="BROWSER" />
      <FigureTile x={38} y={176} icon="api" label="YOUR API" />
      <FigureTile x={38} y={268} icon="clock" label="SCHEDULE" />
      {routes.map((d) => <path d={d} fill="none" stroke="currentColor" stroke-opacity=".35" stroke-dasharray="3 3"></path>)}
      <rect x="186" y="112" width="268" height="172" stroke="currentColor" stroke-opacity=".5" {...stylex.attrs(figureOne.page)}></rect>
      <text x="200" y="134" font-size="10.5" letter-spacing="1" fill="currentColor">AKTER</text>
      <rect x="200" y="148" width="240" height="120" fill="none" stroke="currentColor" stroke-opacity=".45" stroke-dasharray="3 3"></rect>
      <rect x="216" y="140" width="128" height="16" {...stylex.attrs(figureOne.page)}></rect>
      <text x="222" y="152" font-size="10.5" letter-spacing="1" fill="currentColor">ONE TRANSACTION</text>
      <g transform="translate(222,168)">
        <rect width="64" height="64" {...stylex.attrs(figureOne.ink)}></rect>
        <g transform="translate(18,18)" fill="none" {...stylex.attrs(figureOne.mark)}>
          {
            mark.map((figure) =>
              figure.tag === "polyline" ? (
                <polyline {...figure.attributes} stroke-width="3.2"></polyline>
              ) : (
                <line {...figure.attributes} stroke-width="3.2"></line>
              ),
            )
          }
        </g>
      </g>
      <text x="254" y="252" text-anchor="middle" font-size="10.5" letter-spacing="1" fill="currentColor" fill-opacity=".7">AGENT/S_41</text>
      <path d="M286 200 H360" stroke="currentColor" stroke-width="1.2"></path>
      <path d="M354 196 l6 4 -6 4" fill="none" stroke="currentColor" stroke-width="1.2"></path>
      <text x="323" y="192" text-anchor="middle" font-size="10" letter-spacing="1" fill="currentColor" fill-opacity=".6">COMMIT</text>
      <FigureTile x={368} y={172} icon="db" label="DATABASE" labelY={74} />
      <text x="487" y="190" text-anchor="middle" font-size="10" letter-spacing="1" fill="currentColor" fill-opacity=".6">PUSH</text>
      <text x="548" y="150" text-anchor="middle" font-size="10.5" letter-spacing="1" fill="currentColor" fill-opacity=".7">LIVE CLIENTS</text>
      <FigureTile x={520} y={170} icon="screens" label="EVERY TAB" sub="UPDATES" />
    </svg>
  </div>
  <figcaption {...stylex.attrs(figureOne.caption)}>{caption}</figcaption>
</figure>
