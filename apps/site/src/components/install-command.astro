---
import * as stylex from "@stylexjs/stylex"
import { installCommand } from "../site.ts"
import { install } from "./install-command.styles.ts"

interface Props {
  command?: string
}

const { command = installCommand } = Astro.props
---

<div {...stylex.attrs(install.root)} data-install>
  <div {...stylex.attrs(install.command)}>
    <span {...stylex.attrs(install.prompt)} aria-hidden="true">$</span>
    <code data-install-text>{command}</code>
  </div>
  <button type="button" {...stylex.attrs(install.copy)} data-install-copy aria-label="Copy install command">
    <svg {...stylex.attrs(install.icon)} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-copy-icon>
      <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect>
      <path d="M10.5 3.5v-.2A1.3 1.3 0 0 0 9.2 2H3.8A1.8 1.8 0 0 0 2 3.8v5.4A1.3 1.3 0 0 0 3.3 10.5h.2"></path>
    </svg>
    <svg {...stylex.attrs(install.icon, install.done)} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-done-icon>
      <path d="m3.5 8.5 3 3 6-7"></path>
    </svg>
  </button>
</div>

<script>
  import { bindCopyButtons } from "../scripts/copy-to-clipboard.ts"

  bindCopyButtons()
</script>
