---
import * as stylex from "@stylexjs/stylex"
import { questionMarker } from "../styles/markers.stylex.ts"
import { faq } from "./faq.styles.ts"

interface Props {
  entries: ReadonlyArray<{ readonly question: string; readonly answer: string }>
}

const { entries } = Astro.props
---

<ul {...stylex.attrs(faq.list)}>
  {
    entries.map((entry, index) => (
      <li {...stylex.attrs(faq.item)}>
        <details {...stylex.attrs(questionMarker)}>
          <summary {...stylex.attrs(faq.summary)}>
            <span {...stylex.attrs(faq.number)}>{String(index + 1).padStart(2, "0")}</span>
            <span {...stylex.attrs(faq.question)}>{entry.question}</span>
            <svg {...stylex.attrs(faq.icon)} width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
              <path d="M1.5 6h9"></path>
              <path d="M6 1.5v9" {...stylex.attrs(faq.stem)}></path>
            </svg>
          </summary>
          <p {...stylex.attrs(faq.answer)}>{entry.answer}</p>
        </details>
      </li>
    ))
  }
</ul>
