---
import * as stylex from "@stylexjs/stylex"
import { quickstartUrl } from "../site.ts"
import { text } from "../styles/text.styles.ts"
import { banner } from "./banner.styles.ts"
import Button from "./button.astro"

interface Props {
  title?: string
  body?: string
}

const {
  title = "Build your first actor today.",
  body = "Open source and Apache-2.0. Start on your laptop, keep the same code in production.",
} = Astro.props
---

<section {...stylex.attrs(banner.root)}>
  <h2 {...stylex.attrs(text.section, banner.title)}>{title}</h2>
  <p {...stylex.attrs(banner.body)}>{body}</p>
  <div {...stylex.attrs(banner.action)}>
    <Button href={quickstartUrl} variant="inverse" tile>Start building</Button>
  </div>
</section>
