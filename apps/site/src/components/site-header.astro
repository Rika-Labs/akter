---
import * as stylex from "@stylexjs/stylex"
import { consoleUrl, githubUrl, pages } from "../site.ts"
import Container from "./container.astro"
import { header } from "./site-header.styles.ts"
import Wordmark from "./wordmark.astro"

interface Props {
  current?: string
  bordered?: boolean
  width?: "site" | "landing"
}

const { current, bordered = true, width = "site" } = Astro.props
const signIn = { label: "Sign in", href: `${consoleUrl}/sign-in` }
const githubMark =
  "M8 1.3a6.7 6.7 0 0 0-2.1 13c.3.1.5-.1.5-.3v-1.2c-1.9.4-2.3-.8-2.3-.8-.3-.8-.8-1-.8-1-.6-.4 0-.4 0-.4.7 0 1 .7 1 .7.6 1 1.6.7 2 .6.1-.4.2-.7.4-.9-1.5-.2-3-.7-3-3.3 0-.7.3-1.3.7-1.8-.1-.2-.3-.9.1-1.8 0 0 .6-.2 1.8.7a6.3 6.3 0 0 1 3.4 0c1.3-.9 1.8-.7 1.8-.7.4.9.1 1.6.1 1.8.4.5.7 1.1.7 1.8 0 2.6-1.6 3.1-3.1 3.3.2.2.5.6.5 1.2v1.8c0 .2.1.4.5.3A6.7 6.7 0 0 0 8 1.3Z"
---

<header {...stylex.attrs(header.root, bordered && header.bordered)}>
  <Container width={width}>
    <div {...stylex.attrs(header.bar)}>
      <a href="/" aria-label="Akter home" {...stylex.attrs(header.home)}>
        <Wordmark />
      </a>
      <nav aria-label="Primary" {...stylex.attrs(header.nav)}>
        {
          pages.map((link) => (
            <a
              href={link.href}
              aria-current={link.href === current ? "page" : undefined}
              {...stylex.attrs(header.link, link.href === current && header.current)}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <div {...stylex.attrs(header.actions)}>
        <a href={githubUrl} rel="noopener noreferrer" {...stylex.attrs(header.github)}>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d={githubMark}></path>
          </svg>
          GitHub
        </a>
        <a href={signIn.href} {...stylex.attrs(header.link)}>
          {signIn.label}
        </a>
      </div>
      <details {...stylex.attrs(header.menu)}>
        <summary {...stylex.attrs(header.menuButton)}>
          Menu
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
            <path d="M1.5 3.5h9M1.5 8.5h9"></path>
          </svg>
        </summary>
        <div {...stylex.attrs(header.menuPanel)}>
          {
            [...pages, signIn].map((link) => (
              <a
                href={link.href}
                aria-current={link.href === current ? "page" : undefined}
                {...stylex.attrs(header.menuLink, link.href === current && header.menuCurrent)}
              >
                {link.label}
              </a>
            ))
          }
          <a href={githubUrl} rel="noopener noreferrer" {...stylex.attrs(header.menuLink)}>
            GitHub
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d={githubMark}></path>
            </svg>
          </a>
        </div>
      </details>
    </div>
  </Container>
</header>
