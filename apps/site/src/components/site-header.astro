---
import * as stylex from "@stylexjs/stylex"
import Button from "./button.astro"
import Container from "./container.astro"
import ExternalIcon from "./external-icon.astro"
import GithubIcon from "./github-icon.astro"
import { header } from "./site-header.styles.ts"
import Wordmark from "./wordmark.astro"
import { consoleUrl, githubUrl, pages } from "../site.ts"

interface Props {
  current?: string
}

const { current } = Astro.props
const signIn = { label: "Sign in", href: `${consoleUrl}/sign-in` }
---

<header {...stylex.attrs(header.root)}>
  <Container>
    <div {...stylex.attrs(header.bar)}>
      <a href="/" aria-label="Akter home" {...stylex.attrs(header.home)}>
        <Wordmark />
      </a>
      <nav aria-label="Primary" {...stylex.attrs(header.nav)}>
        {
          pages.map((link) => (
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              aria-current={link.href === current ? "page" : undefined}
              {...stylex.attrs(header.link, link.href === current && header.current)}
            >
              {link.label}
              {link.external && <ExternalIcon xstyle={header.external} />}
            </a>
          ))
        }
      </nav>
      <div {...stylex.attrs(header.actions)}>
        <Button href={githubUrl} variant="ghost" size="small" external xstyle={header.github}>
          <GithubIcon />
          GitHub
        </Button>
        <Button href={signIn.href} size="small">{signIn.label}</Button>
      </div>
      <details {...stylex.attrs(header.menu)}>
        <summary {...stylex.attrs(header.menuButton)}>
          Menu
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <path d="M1 3.5h10M1 8.5h10"></path>
          </svg>
        </summary>
        <div {...stylex.attrs(header.menuPanel)}>
          {
            pages.map((link) => (
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
                aria-current={link.href === current ? "page" : undefined}
                {...stylex.attrs(header.menuLink)}
              >
                {link.label}
                {link.external && <span aria-hidden="true">↗</span>}
              </a>
            ))
          }
          <a href={githubUrl} rel="noopener noreferrer" target="_blank" {...stylex.attrs(header.menuLink)}>
            GitHub
            <GithubIcon />
          </a>
          <a href={signIn.href} {...stylex.attrs(header.menuLink)}>{signIn.label}</a>
        </div>
      </details>
    </div>
  </Container>
</header>
