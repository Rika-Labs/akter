---
import * as stylex from "@stylexjs/stylex"
import { figureOne } from "./figure-one.styles.ts"

interface Props {
  x: number
  y: number
  icon: "browser" | "api" | "clock" | "db" | "screens"
  label: string
  labelY?: number
  sub?: string
}

const { x, y, icon, label, labelY = 76, sub } = Astro.props
---

<g transform={`translate(${x},${y})`}>
  <rect width="56" height="56" {...stylex.attrs(figureOne.tile)}></rect>
  <g transform="translate(14,14)" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
    {
      icon === "browser" && (
        <>
          <rect x="4" y="6" width="20" height="16" rx="1.5"></rect>
          <path d="M4 10h20"></path>
          <circle cx="7" cy="8" r=".6"></circle>
          <circle cx="9.2" cy="8" r=".6"></circle>
        </>
      )
    }
    {icon === "api" && <path d="M10 8 5 14l5 6M18 8l5 6-5 6M15.5 6l-3 16"></path>}
    {
      icon === "clock" && (
        <>
          <circle cx="14" cy="14" r="9"></circle>
          <path d="M14 9v5l3.5 2"></path>
        </>
      )
    }
    {
      icon === "db" && (
        <>
          <ellipse cx="14" cy="8" rx="8" ry="3"></ellipse>
          <path d="M6 8v12c0 1.7 3.6 3 8 3s8-1.3 8-3V8M6 14c0 1.7 3.6 3 8 3s8-1.3 8-3"></path>
        </>
      )
    }
    {
      icon === "screens" && (
        <>
          <rect x="3" y="6" width="14" height="10" rx="1"></rect>
          <path d="M8 19h4M10 16v3"></path>
          <rect x="15" y="10" width="10" height="8" rx="1" {...stylex.attrs(figureOne.page)}></rect>
        </>
      )
    }
  </g>
  <text x="28" y={labelY} text-anchor="middle" font-size="10.5" letter-spacing="1" fill="currentColor" fill-opacity=".7">{label}</text>
  {sub !== undefined && <text x="28" y="92" text-anchor="middle" font-size="10.5" letter-spacing="1" fill="currentColor" fill-opacity=".45">{sub}</text>}
</g>
