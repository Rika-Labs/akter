---
import * as stylex from "@stylexjs/stylex"
import { text } from "../styles/text.styles.ts"
import { heading } from "./section-heading.styles.ts"

interface Props {
  level?: 1 | 2 | 3
  size?: "page" | "section" | "small"
  align?: "start" | "center"
  lead?: string
  id?: string
}

const { level = 2, size = "section", align = "start", lead, id } = Astro.props
const Tag = `h${level}` as "h1" | "h2" | "h3"
---

<div {...stylex.attrs(heading.root, align === "center" && heading.center)}>
  <Tag
    id={id}
    {...stylex.attrs(
      text.display,
      heading.title,
      size === "page" && heading.page,
      size === "small" && heading.small,
    )}
  >
    <slot />
  </Tag>
  {lead !== undefined && <p {...stylex.attrs(text.body, heading.lead)}>{lead}</p>}
</div>
