---
import * as stylex from "@stylexjs/stylex"
import Drawing from "../illustrations/drawing.astro"
import { portScene } from "../illustrations/scenes.ts"
import { scene } from "./scene.styles.ts"
---

<div {...stylex.attrs(scene.clip)}>
  <svg
    viewBox="0 0 1080 300"
    role="img"
    aria-label="A container port: a gantry crane lifting a container between two stacks, over water"
    {...stylex.attrs(scene.svg, scene.soft, scene.crop)}
  >
    <Drawing items={portScene} />
  </svg>
</div>
