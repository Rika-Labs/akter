---
import * as stylex from "@stylexjs/stylex"
import Drawing from "../illustrations/drawing.astro"
import { cutaway, cutawayViewBox } from "../illustrations/cutaway.ts"
import { scene } from "./scene.styles.ts"
---

<svg
  viewBox={cutawayViewBox}
  role="img"
  aria-label="A shipping container cut away to show an actor's contents: state, a table, events and jobs, with commands arriving on the left and live clients listening on the right"
  {...stylex.attrs(scene.svg, scene.soft)}
>
  <Drawing items={cutaway} />
</svg>
