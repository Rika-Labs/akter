---
import { containerStrip } from "@akter/ui/brand"
import * as stylex from "@stylexjs/stylex"
import { renderDrawing } from "../illustrations/render-drawing.ts"
import { portScene } from "../illustrations/scenes.ts"
import { art } from "./art.styles.ts"

interface Props {
  source: "crane" | "strip"
  viewBox: string
  label?: string
  phoneCrop?: boolean
  xstyle?: stylex.StyleXStyles
}

const markup = {
  crane: renderDrawing(portScene),
  strip: renderDrawing(containerStrip.drawing),
}
const { source, viewBox, label, phoneCrop = false, xstyle } = Astro.props
---

<div {...stylex.attrs(phoneCrop && art.clip)}>
  <svg
    viewBox={viewBox}
    preserveAspectRatio="xMidYMid meet"
    role={label === undefined ? undefined : "img"}
    aria-label={label}
    aria-hidden={label === undefined ? "true" : undefined}
    {...stylex.attrs(art.svg, phoneCrop && art.phoneCrop, xstyle)}
  >
    <Fragment set:html={markup[source]} />
  </svg>
</div>
