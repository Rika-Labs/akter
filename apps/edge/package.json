{
  "name": "@akter/edge",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings --threads 1 .",
    "test:integration": "bun --bun ../../node_modules/vitest/vitest.mjs run --root ../.. apps/edge/src",
    "test": "bun --bun ../../node_modules/vitest/vitest.mjs run --root ../.. apps/edge/src/config.test.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@rikalabs/akter": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@akter/deployments": "workspace:*",
    "@akter/postgres": "workspace:*",
    "@types/pg": "8.23.1",
    "pg": "8.23.0",
    "vitest": "catalog:"
  }
}
