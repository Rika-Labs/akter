{
  "name": "@rikalabs/akter-cli",
  "version": "0.2.0",
  "description": "The Akter command-line tool for Akter Cloud",
  "keywords": [
    "actors",
    "akter",
    "durable",
    "effect"
  ],
  "homepage": "https://github.com/Rika-Labs/akter#readme",
  "bugs": "https://github.com/Rika-Labs/akter/issues",
  "license": "Apache-2.0",
  "author": "Rika Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rika-Labs/akter.git",
    "directory": "apps/cli"
  },
  "bin": {
    "akter": "dist/main.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": "./dist/main.js",
    "./cloud-api": "./dist/cloud-api/index.js"
  },
  "publishConfig": {
    "types": "./dist/main.d.ts",
    "exports": {
      ".": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      },
      "./cloud-api": {
        "types": "./dist/cloud-api/index.d.ts",
        "default": "./dist/cloud-api/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun build src/main.ts --target node --format esm --external '@effect/*' --external effect --external '@rikalabs/akter' --external '@rikalabs/akter/*' --outfile dist/main.js && bun build ../../packages/cloud-api/src/index.ts --target node --format esm --external effect --external '@rikalabs/akter' --external '@rikalabs/akter/*' --outfile dist/cloud-api/index.js && cp -R .cache/declarations/packages/cloud-api/src/. dist/cloud-api/ && cp .cache/declarations/apps/cli/src/main.d.ts dist/main.d.ts",
    "prepublishOnly": "echo 'Publish through the release workflow: push a v<version> tag.' && exit 1",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings --threads 1 .",
    "test": "bun --bun ../../node_modules/vitest/vitest.mjs run --root ../.. apps/cli/src --exclude apps/cli/src/commands/storage/check.s3.test.ts",
    "test:integration": "bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@rikalabs/akter": "workspace:*"
  },
  "devDependencies": {
    "@akter/cloud-api": "workspace:*",
    "@aws-sdk/client-s3": "3.1148.0",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24.0.0"
  }
}
