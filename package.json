{
  "name": "@akter/monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*"
    ],
    "catalog": {
      "effect": "4.0.0",
      "@effect/platform-browser": "4.0.0",
      "@effect/platform-bun": "4.0.0",
      "@effect/platform-node-shared": "4.0.0",
      "@effect/platform-node": "4.0.0",
      "@effect/sql-pg": "4.0.0",
      "@effect/sql-pglite": "4.0.0",
      "@effect/vitest": "4.0.0",
      "typescript": "7.0.2",
      "vitest": "5.0.1",
      "foldkit": "0.163.0",
      "@foldkit/vite-plugin": "0.24.0",
      "@stylexjs/stylex": "0.19.1",
      "@stylexjs/unplugin": "0.19.1",
      "astro": "7.3.5",
      "drizzle-orm": "1.0.0-rc.5-5935859",
      "drizzle-kit": "1.0.0-rc.5-5935859",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "vite": "8.3.0",
      "unplugin": "2.3.11"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "dev": "docker compose -f infra/local/compose.yaml up --build",
    "dev:apps": "bun --env-file=.env run turbo run dev",
    "build": "turbo run build",
    "typecheck": "GOMAXPROCS=1 turbo run typecheck --concurrency=100%",
    "test": "turbo run test --concurrency=100%",
    "test:integration": "turbo run test:integration --concurrency=100%",
    "test:e2e": "turbo run test:e2e --filter=@akter/e2e",
    "lint:directives": "bun tooling/oxlint/src/directives.ts",
    "lint": "bun run lint:directives && bun run lint:structure && GOMAXPROCS=1 turbo run lint lint:root --concurrency=100%",
    "lint:structure": "bun tooling/structure/src/index.ts",
    "pack:check": "bun .github/src/pack.ts",
    "pack:smoke": "bun .github/src/release/smoke.ts",
    "lint:root": "oxlint --type-aware --deny-warnings --threads 1 *.ts",
    "format": "oxfmt . '!research/**'",
    "format:check": "oxfmt --check . '!research/**'",
    "check": "bun run lint:directives && bun run lint:structure && bun run format:check && GOMAXPROCS=1 turbo run lint lint:root typecheck test build --concurrency=100% && bun run pack:check",
    "check:ci": "bun run lint:directives && bun run lint:structure && bun run format:check && bun run pack:check && bun run --cwd apps/e2e playwright install --with-deps chromium --only-shell && REPLICA=$(bun .github/src/replica.ts) && TEST_REPLICA_DATABASE_URL=$REPLICA GOMAXPROCS=1 turbo run lint lint:root typecheck test build test:integration test:e2e --concurrency=100% --summarize"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/tsgo": "0.45.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "effect": "catalog:",
    "oxfmt": "0.68.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.11.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
