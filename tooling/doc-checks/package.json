{
  "name": "@durable-actors/doc-checks",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings --threads 1 .",
    "test": "bun --bun ../../node_modules/vitest/vitest.mjs run --root ../.. tooling/doc-checks/src"
  },
  "dependencies": {
    "@durable-actors/core": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "1.4.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
