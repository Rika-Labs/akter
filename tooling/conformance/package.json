{
  "name": "@akter/conformance",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/conformance.ts",
    "./cluster": "./src/cluster.ts",
    "./simulate": "./src/simulate.ts",
    "./simulate-cluster": "./src/simulate-cluster.ts",
    "./workflow-engine": "./src/conformance/workflow-engine.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings --threads 1 .",
    "test": "bun --bun ../../node_modules/vitest/vitest.mjs run --root ../.. tooling/conformance/src/cluster.test.ts tooling/conformance/src/simulate.test.ts tooling/conformance/src/simulate-cluster.test.ts tooling/conformance/src/conformance.test.ts tooling/conformance/src/conformance/pglite/backend.test.ts tooling/conformance/src/conformance/crash/pglite-node.test.ts tooling/conformance/src/conformance/workflow-engine.test.ts tooling/conformance/src/conformance/statements.test.ts tooling/conformance/src/conformance/postgres/shards.test.ts tooling/conformance/src/conformance/provider",
    "test:pglite": "bun --bun ../../node_modules/vitest/vitest.mjs run --config tooling/conformance/vitest.pglite.config.ts --root ../..",
    "test:integration": "bun run test:integration:postgres && bun run test:integration:drills",
    "test:integration:postgres": "bun --bun ../../node_modules/vitest/vitest.mjs run --config tooling/conformance/vitest.integration.config.ts --root ../..",
    "test:integration:drills": "bun --bun ../../node_modules/vitest/vitest.mjs run --no-file-parallelism --root ../.. tooling/conformance/src/conformance/crash/drills"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/sql-pglite": "catalog:",
    "@effect/vitest": "catalog:",
    "@electric-sql/pglite": "0.5.8",
    "@rikalabs/akter": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "pg": "8.23.0",
    "vitest": "catalog:"
  }
}
