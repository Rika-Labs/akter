{
  "name": "@akter/conformance",
  "private": true,
  "type": "module",
  "exports": {
    "./workflow-engine": "./src/conformance/workflow-engine.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings --threads 1 .",
    "test": "bun --bun ../../node_modules/vitest/vitest.mjs run --root ../.. tooling/conformance/src",
    "bench:engine": "bun src/conformance/engine-benchmark.ts",
    "bench:engine:node": "node src/conformance/engine-benchmark.ts",
    "bench:pages": "bun src/conformance/page-benchmark.ts",
    "bench:pages:node": "node src/conformance/page-benchmark.ts"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  }
}
