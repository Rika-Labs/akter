{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": [
    "./node_modules/@effect/tsgo/oxlint-presets/recommended.json",
    "./node_modules/@effect/tsgo/oxlint-presets/correctness.json",
    "./node_modules/@effect/tsgo/oxlint-presets/antipattern.json",
    "./node_modules/@effect/tsgo/oxlint-presets/effect-native.json",
    "./node_modules/@effect/tsgo/oxlint-presets/style.json"
  ],
  "categories": {
    "correctness": "error"
  },
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tooling/oxlint/anti-slop/plugin.ts"
    },
    {
      "name": "akter",
      "specifier": "./tooling/oxlint/src/structure.ts"
    }
  ],
  "rules": {
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-manual-effect-error-tag": "error",
    "anti-slop/no-manual-tag-comparison": "error",
    "anti-slop/no-manual-tagged-construction": "error",
    "anti-slop/no-service-constructor-imports": "error",
    "anti-slop/prefer-effect-match": "error",
    "akter/filename-kebab-case": "error",
    "akter/no-parent-echo-in-filename": "error",
    "akter/no-role-suffix-filename": "error",
    "akter/no-generic-directory-segment": "error",
    "akter/no-runtime-import-outside-runtime": "error",
    "akter/no-decision-references": "error",
    "akter/no-inline-comments": "error"
  },
  "overrides": [
    {
      "files": [
        "apps/self-host/src/bun.ts",
        "apps/self-host/src/node.ts",
        "apps/self-host/src/check.ts",
        "apps/self-host/src/peers.ts",
        "apps/self-host/src/probe.ts"
      ],
      "rules": { "effecttsgo/strict-effect-provide": "off" }
    },
    {
      "files": [
        "apps/cli/src/platform.ts",
        "apps/self-host/src/node.ts",
        "apps/self-host/src/peers.ts"
      ],
      "rules": { "effecttsgo/node-builtin-import": "off" }
    },
    {
      "files": [
        "packages/akter/src/testing/conformance/*/harness.ts",
        "packages/akter/src/testing/conformance/transports/wire.ts"
      ],
      "rules": {
        "effecttsgo/missing-pipeable-signature": "off"
      }
    },
    {
      "files": ["packages/akter/src/runtime/peering/transport.test.ts"],
      "rules": {
        "effecttsgo/process-env": "off"
      }
    },
    {
      "files": ["packages/akter/src/runtime/peering/*.ts"],
      "rules": {
        "effecttsgo/node-builtin-import": "off"
      }
    },
    {
      "files": ["tooling/local-verify/src/*.ts"],
      "rules": {
        "effecttsgo/async-function": "off",
        "effecttsgo/global-console": "off",
        "effecttsgo/global-date": "off",
        "effecttsgo/global-timers": "off",
        "effecttsgo/missing-pipeable-signature": "off",
        "effecttsgo/node-builtin-import": "off",
        "effecttsgo/process-env": "off",
        "effecttsgo/schema-sync": "off",
        "effecttsgo/strict-boolean-expressions": "off"
      }
    },
    {
      "files": ["packages/react/src/*.ts"],
      "rules": {
        "effecttsgo/async-function": "off",
        "effecttsgo/missing-pipeable-signature": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/.astro/**",
    ".local/**",
    "tooling/oxlint/anti-slop/**",
    "**/templates/**"
  ]
}
