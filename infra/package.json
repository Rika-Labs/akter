{
  "name": "@akter/infra",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings --threads 1 .",
    "test": "bun --bun ../node_modules/vitest/vitest.mjs run --root .. --exclude infra/src/neki/logical-database.test.ts infra/src",
    "test:integration": "bun --bun ../node_modules/vitest/vitest.mjs run --root .. infra/src/neki/logical-database.test.ts",
    "plan": "alchemy plan",
    "plan:offline": "bun src/preview.ts",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "deploy:github": "alchemy deploy stacks/github.ts --stage github",
    "guard": "bun src/guard.ts",
    "stages": "bun src/stages.ts"
  },
  "dependencies": {
    "@alchemy.run/frontend-frameworks": "catalog:",
    "@distilled.cloud/axiom": "catalog:",
    "@distilled.cloud/core": "catalog:",
    "@distilled.cloud/planetscale": "catalog:",
    "@distilled.cloud/vercel": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@rikalabs/akter": "workspace:*",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
