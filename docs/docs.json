{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Akter",
  "description": "The framework for durable, stateful backends that power realtime apps, background work, and agents.",
  "colors": {
    "primary": "#0b0d0b",
    "light": "#ffc300",
    "dark": "#0b0d0b"
  },
  "background": {
    "color": {
      "light": "#fafaf9"
    }
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/light.svg",
    "href": "https://akter.dev"
  },
  "favicon": "/favicon.svg",
  "styling": {
    "codeblocks": {
      "theme": "css-variables"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": ["quickstart", "guides/concepts", "product/fit-and-non-fit"]
          },
          {
            "group": "Guides",
            "pages": ["guides/effect-into-the-commit", "guides/testing", "guides/deploy"]
          },
          {
            "group": "Compare",
            "pages": ["guides/comparison"]
          },
          {
            "group": "Self-host operations",
            "pages": [
              "operations/self-host",
              "operations/01-deployment",
              "operations/02-migrations",
              "operations/03-observability",
              "operations/04-backup-restore",
              "operations/support-matrix",
              "operations/runbooks",
              "operations/inspection-views",
              "operations/retention",
              "operations/alpha-upgrades",
              "operations/05-releasing"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Runtime",
            "pages": [
              "api/01-server-api",
              "api/02-context",
              "api/03-typescript-sdk",
              "api/04-drizzle"
            ]
          },
          {
            "group": "Clients and CLI",
            "pages": [
              "api/05-generated-clients",
              "api/06-cli",
              "api/07-cloud-logs",
              "api/08-cloud-usage",
              "api/generated-contracts"
            ]
          },
          {
            "group": "Conventions",
            "pages": ["api/naming", "api/versioning", "api/post-foundation-sketches"]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Blog",
        "href": "https://akter.dev/blog"
      },
      {
        "label": "Changelog",
        "href": "https://akter.dev/changelog"
      },
      {
        "type": "github",
        "label": "GitHub",
        "href": "https://github.com/Rika-Labs/akter"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://app.akter.dev/sign-in"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Rika-Labs/akter",
      "website": "https://akter.dev"
    }
  },
  "redirects": [
    {
      "source": "/contracts/:slug*",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/docs/contracts/:slug*.md"
    },
    {
      "source": "/decisions/:slug*",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/docs/decisions/:slug*.md"
    },
    {
      "source": "/architecture/:slug*",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/docs/architecture/:slug*.md"
    },
    {
      "source": "/vision/:slug*",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/docs/vision/:slug*.md"
    },
    {
      "source": "/milestones/:slug*",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/docs/milestones/:slug*.md"
    },
    {
      "source": "/BENCHMARKS",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/BENCHMARKS.md"
    },
    {
      "source": "/product/competitive-positioning",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/docs/product/competitive-positioning.md"
    },
    {
      "source": "/packages/:slug*",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/packages/:slug*"
    }
  ],
  "contextual": {
    "options": ["copy", "view", "claude", "chatgpt"]
  }
}
