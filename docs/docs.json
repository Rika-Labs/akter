{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Akter",
  "description": "The framework for durable actors, deterministic actions, journaled jobs, realtime state, and bucket-backed stores.",
  "colors": {
    "primary": "#0b0d0b",
    "light": "#ffc300",
    "dark": "#0b0d0b"
  },
  "background": {
    "color": {
      "light": "#fafaf9",
      "dark": "#0b0d0b"
    }
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "PolySans",
    "source": "https://akter.dev/fonts/PolySans-variable.woff2",
    "format": "woff2"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://akter.dev"
  },
  "favicon": "/favicon.svg",
  "styling": {
    "codeblocks": {
      "theme": "css-variables"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "quickstart",
              "guides/concepts",
              "guides/actions-and-jobs",
              "product/fit-and-non-fit"
            ]
          },
          {
            "group": "Guides",
            "pages": ["guides/testing", "guides/deploy", "guides/comparison"]
          },
          {
            "group": "Self-host operations",
            "pages": [
              "operations/self-host",
              "operations/01-deployment",
              "operations/02-migrations",
              "operations/03-observability",
              "operations/04-backup-restore",
              "operations/support-matrix",
              "operations/runbooks",
              "operations/retention",
              "operations/alpha-upgrades",
              "operations/05-releasing"
            ]
          }
        ]
      },
      {
        "tab": "Akter Cloud",
        "groups": [
          {
            "group": "Akter Cloud",
            "pages": [
              "cloud/get-started",
              "cloud/storage",
              "cloud/deploy",
              "cloud/environment-variables",
              "cloud/logs",
              "cloud/pricing-and-limits",
              "cloud/account-and-data"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Runtime",
            "pages": [
              "api/01-server-api",
              "api/02-context",
              "api/03-typescript-sdk",
              "api/jobs",
              "api/lists-and-find",
              "api/forks"
            ]
          },
          {
            "group": "Clients and CLI",
            "pages": [
              "api/06-cli",
              "api/07-cloud-logs",
              "api/08-cloud-usage",
              "api/09-environment-api-keys",
              "api/generated-contracts"
            ]
          },
          {
            "group": "Conventions",
            "pages": ["api/naming", "api/versioning"]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "label": "GitHub",
        "href": "https://github.com/Rika-Labs/akter"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://app.akter.dev/sign-in"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Rika-Labs/akter",
      "website": "https://akter.dev"
    }
  },
  "redirects": [
    {
      "source": "/cloud/bring-your-database",
      "destination": "/cloud/storage"
    },
    {
      "source": "/contracts/02-command-turns",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/docs/contracts/02-actions.md"
    },
    {
      "source": "/contracts/03-transactions",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/docs/contracts/03-durability.md"
    },
    {
      "source": "/contracts/04-receipts",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/docs/contracts/03-durability.md"
    },
    {
      "source": "/contracts/06-storage-ownership",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/docs/contracts/06-storage.md"
    },
    {
      "source": "/contracts/:slug*",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/docs/contracts/:slug*.md"
    },
    {
      "source": "/decisions/:slug*",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/docs/decisions/:slug*.md"
    },
    {
      "source": "/milestones/:slug*",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/docs/milestones/:slug*.md"
    },
    {
      "source": "/BENCHMARKS",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/BENCHMARKS.md"
    },
    {
      "source": "/product/competitive-positioning",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/docs/product/competitive-positioning.md"
    },
    {
      "source": "/packages/:slug*",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/packages/:slug*"
    },
    {
      "source": "/api/04-drizzle",
      "destination": "/api/01-server-api"
    },
    {
      "source": "/api/05-generated-clients",
      "destination": "/api/03-typescript-sdk"
    },
    {
      "source": "/api/post-foundation-sketches",
      "destination": "/api/01-server-api"
    },
    {
      "source": "/architecture/data-model",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/docs/architecture/03-storage-layout.md"
    },
    {
      "source": "/architecture/transaction-catalog",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/docs/architecture/04-dispatch.md"
    },
    {
      "source": "/cloud/choose-postgres",
      "destination": "/cloud/storage"
    },
    {
      "source": "/cloud/database",
      "destination": "/cloud/storage"
    },
    {
      "source": "/operations/inspection-views",
      "destination": "/operations/03-observability"
    },
    {
      "source": "/vision/03-relational-data",
      "destination": "https://github.com/Rika-Labs/akter/blob/main/docs/vision/02-product-model.md"
    },
    {
      "source": "/guides/effect-into-the-commit",
      "destination": "/guides/actions-and-jobs"
    }
  ],
  "contextual": {
    "options": ["copy", "view", "claude", "chatgpt"]
  }
}
